# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking
.mypy_cache/
*.tsbuildinfo

# Node / frontend build output (Cue app, dashboard) — regenerated by the toolchain
node_modules/
.vite/

# Ruff
.ruff_cache/

# Secrets — never commit these
.env
.env.*
*.key
*.pem
secrets/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs (runtime output, not the curated SESSION_LOG.md)
logs/*.log
logs/*.jsonl

# Execution reports — runtime output of the orchestrator
logs/executions/

# Generated knowledge — runtime output of the orchestrator, same rule as above.
# Provenance decides, not type: entries stamped "Captured by the Execution
# Orchestrator" live here and stay out of the source diff; human-authored
# research remains in knowledge/research/ and IS version-controlled.
# The loader rglobs knowledge/, so these are still fully loaded, searchable,
# and counted — they are simply not source-controlled.
knowledge/runtime/

# Agent runtime — run logs and the seeded agent registry (runtime state)
logs/agents/
agents/active/
agents/.sequences.json

# Confluence publish mapping/history — local runtime state (never secrets)
logs/publish/

# Project registry — runtime state with machine-specific absolute paths
config/projects.json

# MondayOS local configuration template
#
# Copy this file to `.env`, replace the placeholders, and run `chmod 600 .env`.
# Never commit `.env`, tokens, API keys, authenticated CLI state, or runtime data.

# Required for the Telegram control plane.
TELEGRAM_BOT_TOKEN=your-botfather-token
MONDAYOS_TELEGRAM_ALLOWED_USER_IDS=your-numeric-telegram-user-id

# Optional: comma-separated numeric group IDs. Private chat is recommended.
# MONDAYOS_TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

# Keep false until `monday build capabilities` reports ready. When true, private
# plain text and /build requests use the subscription-authenticated build flow.
MONDAYOS_TELEGRAM_LIVE_BUILD=false

# Telegram long-poll timeout in seconds; accepted range is 1 through 50.
MONDAYOS_TELEGRAM_POLL_TIMEOUT=30

# Optional: pin productive advisory-team stages to one API provider. Leave
# unset for role-aware fallback. This never replaces the final OpenAI reviewer.
# MONDAYOS_TELEGRAM_PROVIDER=deepseek

# Optional advisory/workspace providers. These keys are not required for the
# subscription-first `monday build` path, which uses authenticated coding CLIs.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional: pin the AI Workspace provider. Valid configured providers are
# anthropic, openai, deepseek, or ollama. Leave unset for automatic selection.
# MONDAYOS_PROVIDER=anthropic

# Optional model overrides.
# MONDAYOS_ANTHROPIC_MODEL=claude-sonnet-4-6
# MONDAYOS_OPENAI_MODEL=gpt-4o-mini
# MONDAYOS_DEEPSEEK_MODEL=deepseek-chat
# MONDAYOS_OLLAMA_MODEL=llama3
# OLLAMA_HOST=http://localhost:11434
